{
  "name": "site-form-dev-stand",
  "private": true,
  "version": "1.0.0",
  "description": "Локальный стенд и тесты формы заявки на обучение. Боевая сборка живёт уровнем выше на серверах и в этом репозитории не хранится.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "stand:init": "node dev-stand/init.mjs",
    "pretest:unit": "node dev-stand/init.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node dev-stand/init.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "foundation-sites": "^6.9.0",
    "normalize.css": "^8.0.1",
    "ru-validation-codes": "^2.9.0",
    "vee-validate": "^3.4.15",
    "vue": "^2.7.16",
    "vue-js-modal": "^2.0.1",
    "vue-simple-suggest": "^1.11.0",
    "vue-the-mask": "^0.11.1",
    "vue-toast-notification": "^0.6.3",
    "vuex": "^3.6.2",
    "vuex-map-fields": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@vue/test-utils": "^1.3.6",
    "jsdom": "^22.1.0",
    "sass": "^1.83.0",
    "vite": "^4.5.5",
    "vite-plugin-vue2": "^2.0.3",
    "vitest": "^0.34.6"
  }
